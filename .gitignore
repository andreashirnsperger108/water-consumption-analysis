# Python
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
dist/
build/

# Environments
.venv/
venv/
env/
.env
.env.*

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# Data / Models / Outputs (typisch nicht versionieren)
# data/raw
# data/interim
# data/processed
models/
exports/
reports/figures/

# Allow placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!exports/.gitkeep
!reports/figures/.gitkeep
!docs/figures/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log

# Coverage / pytest
.coverage
htmlcov/
.pytest_cache/

# Secrets
*.pem
*.key
